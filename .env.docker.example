# Empty: make init sets it to the project directory name. Every project and every git worktree needs its own.
DOCKER_PROJECT_NAME=

APP_NAME=Laravel
APP_ENV=local
APP_DEBUG=true
APP_PORT=8000
APP_URL=http://localhost:8000

DB_CONNECTION=mariadb
DB_DATABASE=one_market
DB_USERNAME=laravel
DB_PASSWORD=laravel
DB_ROOT_PASSWORD=root
FORWARD_DB_PORT=3307
MARIADB_TEST_DATABASE=one_market_testing

CACHE_STORE=redis
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_CLIENT=phpredis

VITE_PORT=5173
VITE_HMR_HOST=localhost

RUN_MIGRATIONS=1

# Git worktrees: `make worktree-setup` writes WORKTREE_*, DOCKER_INFRA_PROJECT and per-worktree
# ports, databases and database user into the worktree's own .env - never set them here.
# Optional first port of this project's worktree port block (default: derived from DOCKER_PROJECT_NAME, 20000-29900):
# WORKTREE_PORT_BASE=
